  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8B95A7" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "#A7E5A4" }
    },
    {
      "name": "String escapes and numeric literals",
      "scope": ["constant.character.escape", "constant.numeric"],
      "settings": { "foreground": "#F3BE85" }
    },
    {
      "name": "Keywords and language constants",
      "scope": ["keyword", "storage", "constant.language", "support.constant"],
      "settings": { "foreground": "#D7B0F4" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#8ABEFF" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.namespace"],
      "settings": { "foreground": "#79D8D8" }
    },
    {
      "name": "Properties, keys, and attributes",
      "scope": ["variable.other.property", "variable.other.object.property", "entity.other.attribute-name", "meta.object-literal.key", "support.type.property-name", "entity.name.tag"],
      "settings": { "foreground": "#B9D8FF" }
    },
    {
      "name": "Constants and enum members",
      "scope": ["variable.other.constant", "constant.other", "variable.other.enummember"],
      "settings": { "foreground": "#F2C68D" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#CAD2DF" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#8ABEFF", "fontStyle": "bold" }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8ABEFF", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "comment": "#8B95A7",
    "string": "#A7E5A4",
    "regexp": "#A7E5A4",
    "number": "#F3BE85",
    "keyword": "#D7B0F4",
    "operator": "#CAD2DF",
    "function": "#8ABEFF",
    "function.defaultLibrary": "#8ABEFF",
    "method": "#8ABEFF",
    "method.defaultLibrary": "#8ABEFF",
    "type": "#79D8D8",
    "type.defaultLibrary": "#79D8D8",
    "class": "#79D8D8",
    "class.defaultLibrary": "#79D8D8",
    "interface": "#79D8D8",
    "enum": "#79D8D8",
    "struct": "#79D8D8",
    "typeParameter": "#79D8D8",
    "namespace": "#E8ECF3",
    "variable": "#E8ECF3",
    "parameter": "#E8ECF3",
    "property": "#B9D8FF",
    "property.readonly": "#F2C68D",
    "variable.readonly": "#F2C68D",
    "enumMember": "#F2C68D",
    "decorator": "#D7B0F4"
  }
}
